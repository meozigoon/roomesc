<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>ThirteenthBell.Speedrun</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ThirteenthBell.Core/ThirteenthBell.Core.csproj" />
    <PackageReference Include="NAudio" Version="3.0.0" />
    <Compile Include="../../src/ThirteenthBell/*.cs" Exclude="../../src/ThirteenthBell/Program.cs" />
    <Content Include="../../src/ThirteenthBell/Assets/**/*">
      <Link>Assets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
